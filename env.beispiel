# Umgebungsvariablen fuer dekaru-formular.
# Diese Datei enthaelt bewusst keine Werte. Die echten Werte werden nur im
# Vercel-Projekt unter Settings > Environment Variables eingetragen, nie in
# eine Datei im Repo.

# SMTP-Server des Versanddienstes, z.B. der Hostname laut Anbieter-Doku
FORMULAR_SMTP_HOST=
# 465 (TLS von Anfang an) oder 587 (STARTTLS)
FORMULAR_SMTP_PORT=
# "true" bei Port 465, "false" bei Port 587 (dann wird STARTTLS erzwungen)
FORMULAR_SMTP_SECURE=
# Benutzername des Versandkontos
FORMULAR_SMTP_USER=
# Passwort oder App-Passwort des Versandkontos
FORMULAR_SMTP_PASS=
# Absenderadresse aller Mails, muss zum Versandkonto passen (SPF/DKIM)
FORMULAR_SMTP_FROM=

# Optional: Mindestzeit in Millisekunden zwischen Seitenaufruf und Absenden.
# Standard 3000.
FORMULAR_MINDESTZEIT_MS=
