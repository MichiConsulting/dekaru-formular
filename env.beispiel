# Umgebungsvariablen fuer dekaru-formular.
# Diese Datei enthaelt bewusst keine Werte. Die echten Werte werden nur im
# Vercel-Projekt unter Settings > Environment Variables eingetragen, nie in
# eine Datei im Repo.

# SMTP-Server: smtp-relay.gmail.com (Google Workspace SMTP-Relay)
FORMULAR_SMTP_HOST=
# 587 (STARTTLS, erzwungen)
FORMULAR_SMTP_PORT=
# "false" bei Port 587 (dann wird STARTTLS erzwungen), "true" nur bei Port 465
FORMULAR_SMTP_SECURE=
# Vollstaendige Workspace-Adresse des Versandkontos (Anmeldung ist immer Pflicht)
FORMULAR_SMTP_USER=
# App-Passwort des Versandkontos
FORMULAR_SMTP_PASS=
# Absenderadresse aller Mails, muss zum Versandkonto passen (SPF/DKIM)
FORMULAR_SMTP_FROM=

# Optional: Mindestzeit in Millisekunden zwischen Seitenaufruf und Absenden.
# Standard 3000.
FORMULAR_MINDESTZEIT_MS=
